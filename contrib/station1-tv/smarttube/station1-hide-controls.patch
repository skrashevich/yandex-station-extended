+    // MOD: some firmwares ignore View.setAlpha() (e.g. Yandex Station 1, Android 6),
+    // so the faded out row stays visible. Move such row below the screen instead.
+    private static Boolean sViewAlphaIgnored;
+
+    private float getFadeTranslateY(View view) {
+        if (sViewAlphaIgnored == null) {
+            View probe = new View(view.getContext());
+            probe.setAlpha(0.5f);
+            sViewAlphaIgnored = probe.getAlpha() != 0.5f;
+        }
+
+        if (!sViewAlphaIgnored || getVerticalGridView() == null) {
+            return mAnimationTranslateY;
+        }
+
+        return Math.max(mAnimationTranslateY, getVerticalGridView().getHeight() - view.getTop());
+    }
